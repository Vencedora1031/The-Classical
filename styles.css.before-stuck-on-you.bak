:root {
  color-scheme: light;
  --ink: #263050;
  --muted: #777f97;
  --plum: #6c74ce;
  --plum-dark: #434c87;
  --pink: #f4a4a5;
  --pink-soft: #fff0ef;
  --gold: #ffd52e;
  --paper: #fffefa;
  --line: #e4e7f5;
  font-family: "DM Sans", sans-serif;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

body {
  min-width: 320px;
  margin: 0;
  color: var(--ink);
  background: #f5f6fd;
}

button,
a {
  font: inherit;
}

#game-screen[hidden],
.landing[hidden],
.end-screen[hidden],
.meadow-level[hidden],
.love-level[hidden],
.finale-level[hidden] {
  display: none;
}

#game-screen {
  min-height: 100vh;
  min-height: 100svh;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 9% 14%, rgb(255 222 79 / 18%), transparent 28rem),
    radial-gradient(ellipse at 94% 55%, rgb(115 130 225 / 13%), transparent 32rem),
    #f5f6fd;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.wallet-display {
  display: inline-flex;
  min-height: 42px;
  align-items: center;
  gap: 8px;
  padding: 5px 12px 5px 7px;
  border: 1px solid rgb(255 233 137 / 80%);
  border-radius: 999px;
  color: #fff5c8;
  background: rgb(28 34 63 / 88%);
  box-shadow: 0 4px 14px rgb(0 0 0 / 22%);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .7px;
  white-space: nowrap;
}

.wallet-display img {
  width: 29px;
  height: 29px;
  object-fit: contain;
  filter: drop-shadow(0 0 5px rgb(177 101 255 / 75%));
}

.wallet-display strong {
  color: #ffe16a;
  font-size: 13px;
}

.landing-wallet {
  position: absolute;
  z-index: 1;
  top: max(24px, env(safe-area-inset-top));
  right: max(28px, env(safe-area-inset-right));
}

.game-wallet {
  border-color: #e8cc5b;
  color: #e9eaff;
  background: #293458;
  box-shadow: 0 3px 0 rgb(28 39 76 / 10%);
}

.end-wallet {
  border-color: #e9d28a;
  color: #fff4cc;
  background: #573914;
}

.music-toggle {
  position: fixed;
  z-index: 10;
  right: max(20px, env(safe-area-inset-right));
  bottom: max(18px, env(safe-area-inset-bottom));
  display: inline-flex;
  min-height: 44px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 9px 15px;
  border: 2px solid #fff0a1;
  border-radius: 999px;
  color: #fff7cc;
  background: #263050;
  box-shadow: 0 4px 0 rgb(17 26 53 / 30%), 0 8px 22px rgb(20 28 52 / 22%);
  cursor: pointer;
  font-size: 12px;
  font-weight: 700;
  transition: transform 160ms ease, color 160ms ease, background-color 160ms ease;
}

.music-toggle[hidden] {
  display: none;
}

body.love-level-active .music-toggle {
  right: auto;
  left: max(20px, env(safe-area-inset-left));
}

.music-toggle:hover:not(:disabled) {
  transform: translateY(-2px);
}

.music-toggle[aria-pressed="true"] {
  color: #293047;
  background: #ffdf36;
}

.music-toggle:focus-visible {
  outline: 3px solid #7480d6;
  outline-offset: 3px;
}

.music-toggle:disabled {
  cursor: not-allowed;
  opacity: .75;
}

.music-icon {
  font-size: 17px;
}

.landing {
  position: relative;
  display: grid;
  width: 100%;
  min-height: 100vh;
  min-height: 100svh;
  overflow: hidden;
  place-items: center;
  isolation: isolate;
  color: white;
  background: #10172c;
}

.landing-art,
.landing::after {
  position: absolute;
  z-index: -1;
  inset: 0;
}

.landing-art {
  background-image: url("assets/rome-adventure.png");
  background-position: center 58%;
  background-size: cover;
  animation: scene-arrive 1.1s ease-out both;
}

.landing::after {
  content: "";
  background:
    linear-gradient(180deg, rgb(7 12 26 / 30%) 0%, rgb(7 12 26 / 13%) 34%, rgb(7 12 26 / 49%) 100%),
    radial-gradient(ellipse at center, rgb(12 17 32 / 43%) 0%, rgb(12 17 32 / 17%) 52%, rgb(5 9 20 / 17%) 100%);
}

.meadow-level {
  position: relative;
  display: grid;
  min-height: 100vh;
  min-height: 100svh;
  overflow: hidden;
  place-items: center;
  isolation: isolate;
  background: #94d5fa url("assets/daisy-meadow.jpg") center / cover no-repeat;
}

.love-level {
  position: relative;
  display: grid;
  min-height: 100vh;
  min-height: 100svh;
  overflow: hidden;
  place-items: center;
  background: #020203;
  color: #ff243f;
}

.finale-level {
  position: relative;
  isolation: isolate;
  min-height: 100vh;
  min-height: 100svh;
  padding: 34px 20px 42px;
  overflow: hidden;
  color: #542b3c;
  background:
    linear-gradient(180deg, rgb(255 239 243 / 34%), rgb(255 227 234 / 55%) 47%, rgb(255 237 241 / 78%)),
    url("assets/stuck-on-you-background.jpg") center 28% / cover fixed;
  text-align: center;
}

.finale-heading {
  position: relative;
  z-index: 1;
  width: min(1000px, 100%);
  margin: 0 auto;
  padding: 8px 16px 0;
}

.finale-eyebrow {
  margin: 0 0 7px;
  color: #8a425d;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 2.5px;
  text-transform: uppercase;
}

.finale-heading h1 {
  margin: 0;
  color: #642b46;
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(30px, 5.4vw, 60px);
  text-shadow: 0 2px 0 rgb(255 255 255 / 60%), 0 8px 28px rgb(136 45 81 / 20%);
}

.finale-intro {
  margin: 8px 0 0;
  color: #78495c;
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(15px, 2vw, 20px);
}

.memory-gallery {
  width: min(1280px, 100%);
  margin: 0 auto;
}

.memory-carousel {
  position: relative;
  perspective: 1500px;
}

.memory-stage {
  position: relative;
  width: 100%;
  height: min(65vh, 640px);
  min-height: 480px;
  margin: 0 auto;
  overflow: hidden;
  touch-action: pan-y;
  perspective: 1500px;
  transform-style: preserve-3d;
}

.memory-photo {
  position: absolute;
  top: 49%;
  left: 50%;
  width: clamp(230px, 29vw, 360px);
  height: min(54vh, 560px);
  min-height: 380px;
  padding: 9px 9px 35px;
  overflow: hidden;
  border: 1px solid rgb(255 255 255 / 90%);
  border-radius: 13px;
  background: linear-gradient(145deg, #fffefa, #f8e8ea);
  box-shadow: 0 24px 70px rgb(91 35 62 / 35%), 0 5px 18px rgb(91 35 62 / 16%);
  cursor: pointer;
  opacity: .84;
  transform-style: preserve-3d;
  transition:
    transform 1100ms cubic-bezier(.2, .72, .2, 1),
    opacity 850ms ease,
    filter 850ms ease,
    box-shadow 500ms ease;
  will-change: transform;
}

.memory-photo.is-active {
  opacity: 1;
  filter: saturate(1.06);
  box-shadow: 0 30px 90px rgb(91 35 62 / 40%), 0 0 45px rgb(255 255 255 / 60%);
}

.memory-photo img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 6px;
  object-fit: cover;
  pointer-events: none;
}

.memory-photo:focus-visible {
  outline: 4px solid #8d4160;
  outline-offset: 6px;
}

.carousel-control {
  position: absolute;
  z-index: 5;
  top: 48%;
  display: grid;
  width: 58px;
  height: 58px;
  place-items: center;
  transform: translateY(-50%);
  border: 1px solid rgb(255 255 255 / 90%);
  border-radius: 50%;
  color: #762d4d;
  background: rgb(255 250 250 / 80%);
  box-shadow: 0 8px 25px rgb(96 35 61 / 22%);
  cursor: pointer;
  font-size: 30px;
  backdrop-filter: blur(9px);
  transition: transform 200ms ease, background-color 200ms ease;
}

.carousel-control:hover {
  transform: translateY(-50%) scale(1.09);
  background: #fff;
}

.carousel-control:focus-visible,
.memory-indicator:focus-visible,
.poem-invitation:focus-visible {
  outline: 3px solid #782d4c;
  outline-offset: 4px;
}

.carousel-previous {
  left: max(8px, calc(50% - 560px));
}

.carousel-next {
  right: max(8px, calc(50% - 560px));
}

.memory-hint {
  position: relative;
  z-index: 5;
  margin: -22px 12px 0;
  color: #75475a;
  font-size: 13px;
  text-shadow: 0 1px rgb(255 255 255 / 80%);
}

.memory-indicators {
  position: relative;
  z-index: 5;
  display: flex;
  justify-content: center;
  gap: 12px;
  margin: 16px 0 0;
}

.memory-indicator {
  width: 11px;
  height: 11px;
  padding: 0;
  border: 1px solid #8f4d67;
  border-radius: 50%;
  background: rgb(255 255 255 / 62%);
  cursor: pointer;
  transition: transform 220ms ease, background-color 220ms ease;
}

.memory-indicator[aria-pressed="true"] {
  transform: scale(1.35);
  background: #863858;
}

.poem-invitation {
  display: flex;
  width: fit-content;
  align-items: center;
  gap: 14px;
  margin: 36px auto 62px;
  padding: 13px 20px;
  border: 1px solid rgb(115 45 73 / 25%);
  border-radius: 999px;
  color: #71334d;
  background: rgb(255 248 249 / 66%);
  box-shadow: 0 8px 28px rgb(112 53 77 / 12%);
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(14px, 2vw, 18px);
  text-decoration: none;
  backdrop-filter: blur(8px);
}

.poem-invitation strong {
  font-family: "DM Sans", sans-serif;
  font-size: 22px;
  animation: invitation-bob 1.5s ease-in-out infinite alternate;
}

.poem-chapter {
  width: min(920px, 100%);
  margin: 0 auto;
  padding: clamp(28px, 6vw, 68px) 0 0;
  scroll-margin-top: 20px;
}

.poem-chapter-heading {
  margin-bottom: 26px;
  color: #673449;
}

.poem-chapter-heading h2 {
  margin: 0;
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(42px, 7vw, 72px);
  text-shadow: 0 2px 0 rgb(255 255 255 / 72%);
}

.poem-chapter-heading > p:last-child {
  margin: 8px 0 0;
  color: #795366;
  font-family: "Playfair Display", Georgia, serif;
  font-size: 17px;
}

.finale-poem {
  width: min(760px, 100%);
  margin: 0 auto;
  padding: clamp(32px, 6vw, 72px) clamp(24px, 8vw, 88px);
  border: 1px solid rgb(255 255 255 / 72%);
  border-radius: 9px;
  color: #50283b;
  background:
    linear-gradient(90deg, rgb(255 255 255 / 34%), transparent 5%, transparent 95%, rgb(255 255 255 / 28%)),
    linear-gradient(135deg, rgb(255 249 244 / 94%), rgb(252 232 230 / 93%) 50%, rgb(255 249 244 / 96%));
  box-shadow:
    0 18px 44px rgb(98 40 62 / 22%),
    inset 0 0 35px rgb(164 102 106 / 10%),
    0 0 0 9px rgb(255 248 247 / 26%);
  font-family: "Playfair Display", Georgia, serif;
  text-align: center;
}

.finale-poem p {
  margin: 0 auto 26px;
  color: #542c40;
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(17px, 2.4vw, 22px);
  line-height: 1.95;
  perspective: 600px;
}

.finale-poem p:last-child {
  margin-bottom: 0;
}

.poem-word {
  display: inline-block;
  opacity: 0;
  filter: blur(4px);
  transform: translateY(10px) rotateX(-18deg);
  transition:
    opacity 450ms ease,
    filter 600ms ease,
    transform 600ms cubic-bezier(.2, .8, .2, 1);
  transition-delay: calc(var(--word-index) * 24ms);
}

.finale-poem p.is-visible .poem-word {
  opacity: 1;
  filter: blur(0);
  transform: translateY(0) rotateX(0);
}

.finale-poem .finale-signature {
  padding-top: 8px;
  color: #8a3d5c;
  font-style: italic;
}

.finale-goodbye {
  width: min(860px, 100%);
  margin: 56px auto 0;
  padding: 36px 20px 16px;
  border-top: 1px solid rgb(115 45 73 / 25%);
}

.finale-goodbye p {
  margin: 0 auto 20px;
  color: #673449;
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(19px, 3vw, 27px);
  line-height: 1.55;
}

.finale-goodbye .back-start-button {
  min-width: 190px;
  justify-content: center;
}

@keyframes invitation-bob {
  from { transform: translateY(-2px); }
  to { transform: translateY(4px); }
}

.photo-dialog {
  position: fixed;
  max-width: min(92vw, 820px);
  max-height: 92svh;
  padding: 22px;
  overflow: visible;
  border: 1px solid rgb(255 224 230 / 40%);
  border-radius: 18px;
  color: #fff3ee;
  background: #160e17;
  box-shadow: 0 24px 100px rgb(0 0 0 / 72%);
}

.photo-dialog::backdrop {
  background: rgb(4 3 7 / 88%);
  backdrop-filter: blur(8px);
}

.photo-dialog img {
  display: block;
  max-width: min(82vw, 760px);
  max-height: 78svh;
  margin: 0 auto;
  object-fit: contain;
}

.photo-dialog p {
  margin: 12px 36px 0 0;
  color: #f8dfe4;
  font-size: 13px;
  text-align: center;
}

.photo-dialog-close {
  position: absolute;
  top: -15px;
  right: -15px;
  display: grid;
  width: 40px;
  height: 40px;
  place-items: center;
  border: 1px solid #ffd8df;
  border-radius: 50%;
  color: #fff;
  background: #542138;
  cursor: pointer;
  font-size: 28px;
  line-height: 1;
}

.photo-dialog-close:focus-visible {
  outline: 3px solid #fff;
  outline-offset: 3px;
}

.love-title {
  position: absolute;
  top: clamp(28px, 7vh, 72px);
  left: 50%;
  display: grid;
  width: min(92%, 760px);
  gap: 8px;
  margin: 0;
  transform: translateX(-50%);
  color: #ff243f;
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(22px, 4vw, 42px);
  line-height: 1.16;
  text-align: center;
  text-shadow: 0 0 10px rgb(255 24 56 / 76%), 0 0 28px rgb(255 24 56 / 38%);
  animation: love-title-arrive 900ms ease-out both;
}

.love-phrase,
.love-name {
  display: block;
}

.love-name {
  font-size: 1.08em;
  font-weight: 700;
}

.love-word {
  display: inline-block;
  opacity: 0;
  animation: love-word-arrive 500ms cubic-bezier(.2, .8, .2, 1) both;
}

.love-phrase .love-word:nth-child(1) { animation-delay: .15s; }
.love-phrase .love-word:nth-child(2) { animation-delay: .35s; }
.love-phrase .love-word:nth-child(3) { animation-delay: .55s; }
.love-phrase .love-word:nth-child(4) { animation-delay: .75s; }
.love-phrase .love-word:nth-child(5) { animation-delay: .95s; }
.love-phrase .love-word:nth-child(6) { animation-delay: 1.15s; }
.love-name .love-word:nth-child(1) { animation-delay: 1.45s; }
.love-name .love-word:nth-child(2) { animation-delay: 1.7s; }

.love-heart {
  display: block;
  width: min(640px, 88vw);
  height: auto;
  margin-top: 74px;
  filter: drop-shadow(0 0 18px rgb(255 24 56 / 42%));
}

.love-next {
  position: absolute;
  right: max(22px, env(safe-area-inset-right));
  bottom: max(24px, env(safe-area-inset-bottom));
  display: grid;
  width: 64px;
  height: 64px;
  place-items: center;
  border: 2px solid #ff4056;
  border-radius: 50%;
  color: #ff243f;
  background: rgb(28 0 5 / 78%);
  box-shadow: 0 0 22px rgb(255 24 56 / 52%);
  cursor: pointer;
  animation: love-next-arrive 500ms ease-out both;
}

.love-next[hidden] {
  display: none;
}

.love-next span {
  font-size: 38px;
  line-height: 1;
}

.love-next:focus-visible {
  outline: 3px solid #fff;
  outline-offset: 4px;
}

.meadow-level::after {
  position: absolute;
  z-index: -1;
  inset: 0;
  content: "";
  background: linear-gradient(180deg, rgb(19 56 87 / 30%), transparent 26%, transparent 70%, rgb(29 68 33 / 14%));
  transition: opacity 700ms ease;
}

.meadow-level.is-uncovered::after {
  opacity: .3;
}

.meadow-header {
  position: absolute;
  z-index: 2;
  top: 0;
  left: 50%;
  display: flex;
  width: min(1160px, calc(100% - 64px));
  height: 76px;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  transform: translateX(-50%);
  border-bottom: 1px solid rgb(255 255 255 / 35%);
}

.meadow-header .brand,
.meadow-header .chapter-label {
  color: #fff;
  text-shadow: 0 2px 8px rgb(15 36 28 / 72%);
}

.meadow-instruction {
  position: absolute;
  z-index: 1;
  top: 92px;
  left: 50%;
  max-width: calc(100% - 32px);
  margin: 0;
  padding: 11px 18px;
  transform: translateX(-50%);
  border: 1px solid rgb(255 255 255 / 72%);
  border-radius: 999px;
  color: #fff;
  background: rgb(25 57 49 / 55%);
  box-shadow: 0 4px 20px rgb(21 44 33 / 25%);
  font-size: clamp(12px, 2vw, 16px);
  font-weight: 700;
  text-align: center;
  text-shadow: 0 1px 4px rgb(0 0 0 / 65%);
  backdrop-filter: blur(8px);
}

.meadow-uncover {
  position: relative;
  display: grid;
  width: clamp(168px, 27vw, 270px);
  aspect-ratio: 1;
  place-items: center;
  border: 0;
  border-radius: 50%;
  color: #466786;
  background: transparent;
  cursor: pointer;
  font-size: clamp(14px, 2vw, 20px);
  font-weight: 800;
  text-shadow: 0 1px 3px #fff;
}

.meadow-uncover[hidden],
.meadow-rock[hidden],
.meadow-letters[hidden],
.meadow-answer-card[hidden] {
  display: none;
}

.white-glow {
  position: absolute;
  z-index: -1;
  inset: 0;
  border: 2px solid rgb(255 255 255 / 92%);
  border-radius: 50%;
  background: rgb(255 255 255 / 93%);
  box-shadow: 0 0 28px 16px rgb(255 255 255 / 88%), 0 0 90px 38px rgb(255 255 255 / 68%);
  animation: meadow-glow 1.8s ease-in-out infinite alternate;
}

.meadow-uncover:hover .white-glow {
  box-shadow: 0 0 38px 22px #fff, 0 0 110px 50px rgb(255 255 255 / 78%);
}

.meadow-rock {
  position: absolute;
  z-index: 1;
  right: max(25px, env(safe-area-inset-right));
  bottom: max(25px, env(safe-area-inset-bottom));
  display: grid;
  width: clamp(150px, 24vw, 270px);
  min-height: 125px;
  place-items: center;
  border: 0;
  background: transparent;
  cursor: pointer;
  animation: rock-arrive 650ms ease-out both;
}

.meadow-rock img {
  display: block;
  width: 100%;
  max-height: 30vh;
  object-fit: contain;
  filter: drop-shadow(0 0 9px #fff) drop-shadow(0 0 24px #dffbff);
  animation: stone-glow 1.5s ease-in-out infinite alternate;
}

.meadow-rock:focus-visible,
.meadow-uncover:focus-visible,
.meadow-answer-controls button:focus-visible,
.meadow-answer-controls input:focus-visible {
  outline: 3px solid #fff;
  outline-offset: 5px;
}

.rock-glow {
  position: absolute;
  right: 0;
  bottom: 4px;
  padding: 6px 11px;
  border-radius: 999px;
  color: #203044;
  background: rgb(255 255 255 / 86%);
  box-shadow: 0 0 16px rgb(255 255 255 / 90%);
  font-size: 11px;
  font-weight: 800;
}

.meadow-rock:disabled {
  cursor: default;
}

.meadow-letters {
  position: absolute;
  z-index: 3;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #fff;
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(90px, 20vw, 190px);
  font-weight: 700;
  letter-spacing: .12em;
  text-shadow: 0 0 12px #fff, 0 0 34px #fff, 0 0 68px #fff, 0 5px 18px rgb(30 50 24 / 55%);
  animation: letters-arrive 800ms cubic-bezier(.2, .8, .2, 1) both;
  pointer-events: none;
}

.meadow-answer-card {
  position: absolute;
  z-index: 4;
  inset: 0;
  display: grid;
  padding: 88px 16px 72px;
  place-items: center;
  background: rgb(20 43 30 / 43%);
  backdrop-filter: blur(5px);
  animation: answer-card-arrive 500ms ease-out both;
}

.meadow-scroll {
  width: min(920px, calc(100vw - 32px));
}

.meadow-scroll-copy {
  position: absolute;
  top: 17%;
  right: 22%;
  bottom: 16%;
  left: 22%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow-y: auto;
  padding: 8px 4px;
  text-align: center;
}

.meadow-scroll-copy h1 {
  margin: 0 0 10px;
  color: #48280d;
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(17px, 2.4vw, 28px);
  line-height: 1.25;
}

.meadow-letter-clue {
  margin: 0 0 10px;
  color: #56300e;
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(13px, 1.8vw, 19px);
}

.meadow-answer-form {
  width: min(380px, 100%);
}

.meadow-answer-form label {
  display: block;
  margin-bottom: 6px;
  color: #56300e;
  font-size: 12px;
  font-weight: 700;
}

.meadow-answer-controls {
  display: flex;
  justify-content: center;
  gap: 6px;
}

.meadow-answer-controls input {
  width: min(220px, 65%);
  min-height: 40px;
  padding: 7px 12px;
  border: 1px solid #a56b20;
  border-radius: 10px;
  color: #38240f;
  background: rgb(255 252 239 / 95%);
  font-size: 16px;
}

.meadow-answer-controls button {
  min-height: 40px;
  padding: 7px 16px;
  border: 1px solid #88551b;
  border-radius: 10px;
  color: #fff9e8;
  background: #644019;
  cursor: pointer;
  font-weight: 700;
}

.meadow-message {
  min-height: 18px;
  margin: 6px 0 0;
  color: #8b2630;
  font-size: 11px;
  font-weight: 700;
  line-height: 1.35;
}

.landing-content {
  display: flex;
  width: min(880px, calc(100% - 36px));
  flex-direction: column;
  align-items: center;
  padding: 48px 0 56px;
  text-align: center;
}

.landing-eyebrow {
  margin-bottom: 23px;
  color: #fff2bd;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  text-shadow: 0 2px 16px rgb(0 0 0 / 65%);
}

.landing-eyebrow span {
  padding: 0 8px;
  color: #ffe54b;
}

.landing-title {
  margin: 0 0 34px;
  color: #ffe229;
  font-family: "DM Sans", sans-serif;
  font-size: clamp(58px, 10vw, 122px);
  font-weight: 700;
  letter-spacing: -.075em;
  line-height: .91;
  text-shadow:
    0 3px 0 #d6971c,
    0 8px 22px rgb(0 0 0 / 48%),
    0 0 42px rgb(255 222 58 / 47%);
  animation: title-flash 2.2s ease-in-out infinite alternate;
}

.play-button {
  display: inline-flex;
  min-width: 178px;
  min-height: 64px;
  align-items: center;
  justify-content: center;
  gap: 18px;
  padding: 15px 25px 15px 31px;
  border: 2px solid rgb(255 250 201 / 85%);
  border-radius: 999px;
  color: #28220b;
  background: #ffdf27;
  box-shadow: 0 7px 0 #bd8418, 0 12px 36px rgb(0 0 0 / 40%);
  cursor: pointer;
  font-size: 23px;
  font-weight: 700;
  transition: transform 160ms ease, background-color 160ms ease, box-shadow 160ms ease;
}

.play-button:hover {
  transform: translateY(-3px) scale(1.035);
  background: #ffeb57;
  box-shadow: 0 9px 0 #bd8418, 0 16px 42px rgb(0 0 0 / 43%);
}

.play-button:active {
  transform: translateY(3px);
  box-shadow: 0 3px 0 #bd8418, 0 8px 22px rgb(0 0 0 / 34%);
}

.play-button:focus-visible,
.home-button:focus-visible {
  outline: 3px solid #fff3aa;
  outline-offset: 5px;
}

.play-arrow {
  display: grid;
  width: 29px;
  height: 29px;
  place-items: center;
  border-radius: 50%;
  color: #ffdf27;
  background: #28220b;
  font-size: 19px;
  line-height: 1;
  transition: transform 160ms ease;
}

.play-button:hover .play-arrow {
  transform: translateX(3px);
}

.landing-subtitle {
  margin: 28px 0 0;
  color: #ffe74b;
  font-size: clamp(19px, 2.7vw, 28px);
  font-weight: 700;
  letter-spacing: -.4px;
  line-height: 1.45;
  text-shadow: 0 2px 3px #271a0c, 0 3px 16px rgb(0 0 0 / 76%);
}

.landing-footnote {
  position: absolute;
  bottom: max(24px, env(safe-area-inset-bottom));
  left: 50%;
  width: max-content;
  max-width: calc(100% - 32px);
  transform: translateX(-50%);
  color: rgb(255 255 255 / 84%);
  font-size: 12px;
  letter-spacing: 1px;
  text-align: center;
  text-shadow: 0 2px 7px rgb(0 0 0 / 85%);
}

.landing-footnote span {
  padding-right: 6px;
  color: #ffe229;
}

.back-start-button:focus-visible {
  outline: 3px solid #ad8dff;
  outline-offset: 3px;
}

.end-screen {
  min-height: 100vh;
  min-height: 100svh;
  padding: 20px 28px 36px;
  overflow-x: hidden;
  overflow-y: auto;
  color: #42280f;
  background:
    radial-gradient(ellipse at 50% 18%, rgb(255 225 135 / 19%), transparent 29rem),
    linear-gradient(155deg, #272c4d, #171d37 62%, #302348);
}

.end-screen-header {
  display: flex;
  width: min(1180px, 100%);
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin: 0 auto;
}

.end-chapter {
  color: #fff1c2;
  font-size: 12px;
  letter-spacing: 1.1px;
  text-shadow: 0 2px 10px rgb(0 0 0 / 45%);
}

.end-chapter > span:first-child {
  margin-right: 6px;
  color: #ffe06a;
}

.end-content {
  display: flex;
  min-height: calc(100svh - 106px);
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16px 0 10px;
  text-align: center;
}

.end-eyebrow {
  margin: 0 0 8px;
  color: #ffe890;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  text-shadow: 0 2px 10px rgb(0 0 0 / 50%);
}

.scroll-stage {
  position: relative;
  width: min(980px, calc(100vw - 36px));
  aspect-ratio: 612 / 408;
  isolation: isolate;
  isolation: isolate;
}

.scroll-art {
  position: absolute;
  z-index: -1;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: fill;
  filter: drop-shadow(0 12px 20px rgb(0 0 0 / 33%));
}

.scroll-copy {
  position: absolute;
  top: 17%;
  right: 22%;
  bottom: 16%;
  left: 22%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow-y: auto;
  padding: 8px 4px;
  scrollbar-color: #8f5b22 transparent;
  scrollbar-width: thin;
}

.scroll-copy h1 {
  margin: 0 0 15px;
  color: #48280d;
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(18px, 2.35vw, 31px);
  font-weight: 700;
  letter-spacing: .1px;
  line-height: 1.38;
  text-shadow: 0 1px 0 rgb(255 244 212 / 70%);
}

.day-letter {
  margin: 0;
  color: #56300e;
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(17px, 2.2vw, 27px);
  font-weight: 600;
}

.day-letter strong {
  display: inline-grid;
  min-width: 1.45em;
  height: 1.45em;
  margin-left: 5px;
  padding: 0 .16em;
  place-items: center;
  border: 1px solid #a56b20;
  border-radius: 50%;
  color: #4b2407;
  background: rgb(255 225 155 / 52%);
  font-size: 1.18em;
  box-shadow: 0 0 12px rgb(195 127 35 / 30%);
}

.end-prompt {
  max-width: min(680px, 100%);
  margin: 1px 0 17px;
  color: #fff0a8;
  font-size: 12px;
  font-weight: 700;
  line-height: 1.5;
  text-align: center;
  text-shadow: 0 2px 8px rgb(0 0 0 / 45%);
}

.back-start-button {
  display: inline-flex;
  min-height: 52px;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 12px 24px;
  border: 2px solid #fff1a1;
  border-radius: 999px;
  color: #2a2441;
  background: linear-gradient(180deg, #ffea74, #ffd239);
  box-shadow: 0 5px 0 #be851d, 0 10px 26px rgb(0 0 0 / 28%);
  cursor: pointer;
  font-size: 15px;
  font-weight: 800;
  transition: transform 160ms ease, filter 160ms ease;
}

.back-start-button:hover {
  transform: translateY(-2px);
  filter: brightness(1.07);
}

.back-start-button:active {
  transform: translateY(2px);
}

.site-header {
  width: min(1160px, calc(100% - 64px));
  height: 76px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgb(71 79 130 / 12%);
}

.brand {
  display: inline-flex;
  gap: 10px;
  align-items: center;
  padding: 0;
  border: 0;
  color: var(--ink);
  background: transparent;
  cursor: pointer;
  font-size: 14px;
  letter-spacing: -.25px;
}

.home-button:hover {
  color: var(--plum-dark);
}

.brand strong {
  font-weight: 700;
}

.brand-mark {
  color: var(--gold);
  -webkit-text-stroke: .45px #c28d18;
  font-size: 21px;
}

.chapter-label {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: #727a96;
  font-size: 12px;
}

.chapter-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #ffcf29;
  box-shadow: 0 0 0 4px #fff4c6;
}

.page-shell {
  width: min(1010px, calc(100% - 48px));
  margin: 0 auto;
}

.intro {
  padding: 42px 0 28px;
  text-align: center;
}

.eyebrow,
.section-kicker {
  color: #6571ba;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.6px;
}

.eyebrow {
  margin: 0 0 12px;
}

.eyebrow span {
  padding: 0 7px;
  color: #e9ad13;
}

h1,
h2,
p {
  margin-top: 0;
}

h1,
.panel-heading h2,
.puzzle-heading h2 {
  font-family: "Playfair Display", Georgia, serif;
  font-weight: 500;
}

h1 {
  margin-bottom: 9px;
  font-size: clamp(34px, 5vw, 45px);
  letter-spacing: -1.1px;
}

h1 em {
  color: #d29b14;
  font-weight: 500;
}

.intro-copy {
  margin-bottom: 0;
  color: #737a91;
  font-size: 13px;
}

.game-card {
  display: grid;
  grid-template-columns: minmax(0, .94fr) minmax(0, 1.06fr);
  min-height: 432px;
  overflow: hidden;
  border: 1px solid #e2e5f4;
  border-radius: 20px;
  background: var(--paper);
  box-shadow: 0 8px 0 #e8eaf5, 0 18px 44px rgb(48 56 112 / 11%);
}

.riddle-panel,
.puzzle-panel {
  min-width: 0;
  padding: 28px 32px 21px;
}

.riddle-panel {
  display: flex;
  flex-direction: column;
  border-right: 1px solid #e8e7dc;
  background:
    radial-gradient(ellipse at 12% 8%, rgb(255 221 70 / 18%), transparent 15rem),
    linear-gradient(150deg, #fffef8, #fff9df 62%, #f5f5ff);
}

.panel-heading,
.puzzle-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.section-kicker {
  margin-bottom: 7px;
  font-size: 9px;
  letter-spacing: 1.55px;
}

.panel-heading h2,
.puzzle-heading h2 {
  margin-bottom: 0;
  font-size: 20px;
  letter-spacing: -.2px;
}

.panel-heading h2 {
  color: #293353;
}

.puzzle-heading h2 {
  color: #fff9dc;
}

.progress-count {
  display: flex;
  align-items: baseline;
  gap: 4px;
  color: #8b90a3;
  font-size: 12px;
}

.progress-count #progress-current {
  color: #35447f;
  font-size: 16px;
  font-weight: 700;
}

.progress-divider {
  color: #c6cada;
}

.progress-track {
  height: 6px;
  margin-top: 19px;
  overflow: hidden;
  border-radius: 8px;
  background: #e7e9f3;
}

.progress-fill {
  width: 25%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #ffb84d, #ffdf36);
  box-shadow: 0 0 10px rgb(255 200 52 / 45%);
  transition: width 450ms ease;
}

.riddle-content {
  position: relative;
  padding-top: 27px;
}

.clue-star {
  display: block;
  margin-bottom: 8px;
  color: #e9b11c;
  font-size: 21px;
  animation: clue-twinkle 2.6s ease-in-out infinite alternate;
}

.riddle-text {
  min-height: 69px;
  margin-bottom: 19px;
  color: #343d5e;
  font-family: "Playfair Display", Georgia, serif;
  font-size: 17px;
  line-height: 1.55;
}

.answer-prompt {
  margin-bottom: 11px;
  color: #777f98;
  font-size: 11px;
}

.answer-options {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.answer-option {
  min-height: 34px;
  padding: 7px 12px;
  border: 1px solid #e2dbb8;
  border-radius: 999px;
  color: #343d5e;
  background: #fffef9;
  box-shadow: 0 2px 0 rgb(49 60 101 / 7%);
  cursor: pointer;
  font-size: 11px;
  transition: border-color 160ms ease, color 160ms ease, background 160ms ease, transform 160ms ease;
}

.answer-option:hover:not(:disabled) {
  transform: translateY(-2px);
  border-color: #e6bb2f;
  color: #29345f;
  background: #fff3ae;
  box-shadow: 0 4px 0 rgb(220 171 28 / 20%);
}

.answer-option:focus-visible {
  outline: 3px solid rgb(104 116 204 / 30%);
  outline-offset: 2px;
}

.answer-option:disabled {
  cursor: default;
}

.answer-option.is-wrong {
  border-color: #edaaa7;
  color: #994e5a;
  background: #fff0ef;
  animation: shake 280ms ease;
}

.answer-option.is-correct {
  border-color: #a4c69c;
  color: #416c53;
  background: #eff8e9;
}

.game-message {
  min-height: 18px;
  margin: 11px 0 0;
  color: #a3495a;
  font-size: 11px;
  line-height: 1.5;
}

.game-message.is-success {
  color: #467653;
}

.panel-footer {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: auto;
  padding-top: 13px;
  border-top: 1px solid rgb(70 71 101 / 11%);
  color: #737c94;
  font-size: 10px;
}

.tiny-sparkle {
  color: #e2a716;
  font-size: 12px;
}

.puzzle-panel {
  display: flex;
  flex-direction: column;
  padding-left: 29px;
  padding-right: 29px;
  background:
    radial-gradient(ellipse at 92% 8%, rgb(119 137 228 / 45%), transparent 16rem),
    linear-gradient(145deg, #303a68, #202b50);
}

.puzzle-heading {
  margin-bottom: 17px;
}

.piece-counter {
  padding: 6px 9px;
  border: 1px solid rgb(255 229 94 / 58%);
  border-radius: 99px;
  color: #293252;
  background: #ffe365;
  box-shadow: 0 2px 0 rgb(12 20 44 / 18%);
  font-size: 10px;
  white-space: nowrap;
}

.puzzle-board {
  position: relative;
  width: 100%;
  overflow: hidden;
  border: 2px solid #fff0a4;
  border-radius: 13px;
  background: #303457;
  box-shadow: 0 5px 0 rgb(15 20 43 / 30%), 0 12px 24px rgb(8 13 34 / 26%);
  aspect-ratio: 736 / 855;
}

.puzzle-art {
  display: block;
  width: 100%;
  height: 100%;
}

.puzzle-piece {
  opacity: 0;
}

.puzzle-piece.is-revealed {
  opacity: 1;
  animation: piece-arrive 550ms ease-out both;
}

.empty-board path {
  fill: none;
  stroke: #c0bdd3;
  stroke-width: 2.5;
  stroke-dasharray: 5 7;
  stroke-linejoin: round;
  stroke-linecap: round;
  transition: opacity 300ms ease;
}

.empty-board rect {
  fill: none;
  stroke: #c0bdd3;
  stroke-width: 2;
  stroke-dasharray: 5 7;
}

.puzzle-board.has-pieces .empty-board path {
  stroke: rgb(255 248 211 / 80%);
  stroke-width: 1.5;
  stroke-dasharray: none;
}

.puzzle-board.has-pieces .empty-board rect {
  stroke: rgb(255 248 211 / 80%);
  stroke-width: 1.5;
  stroke-dasharray: none;
}

.board-hint {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  color: #f7eab7;
  font-family: "Playfair Display", Georgia, serif;
  font-size: 13px;
  line-height: 1.55;
  text-align: center;
  pointer-events: none;
  transition: opacity 350ms ease;
}

.hint-sparkle {
  color: #ffdf36;
  font-size: 23px;
}

.puzzle-board.has-pieces .board-hint {
  opacity: 0;
}

.complete-stamp {
  position: absolute;
  right: 12px;
  bottom: 12px;
  padding: 7px 10px;
  transform: rotate(-6deg) scale(.75);
  border: 1px solid rgb(255 239 206 / 78%);
  border-radius: 4px;
  color: #fff3d7;
  background: rgb(71 62 91 / 55%);
  font-family: "Playfair Display", Georgia, serif;
  font-size: 10px;
  letter-spacing: 1.5px;
  opacity: 0;
  transition: opacity 350ms ease, transform 350ms ease;
}

.complete-stamp span {
  margin-left: 4px;
  color: #f5c2ba;
}

.puzzle-board.is-complete .complete-stamp {
  transform: rotate(-6deg) scale(1);
  opacity: 1;
}

.puzzle-caption {
  min-height: 17px;
  margin: 11px 0 0;
  color: #e5e5ee;
  font-size: 10px;
  text-align: center;
}

.page-footer {
  display: flex;
  justify-content: center;
  gap: 8px;
  padding: 24px 0 30px;
  color: #767e96;
  font-size: 10px;
}

.page-footer span:last-child {
  color: #d49c14;
}

@keyframes piece-arrive {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}

@keyframes meadow-glow {
  from { transform: scale(.94); opacity: .84; }
  to { transform: scale(1.06); opacity: 1; }
}

@keyframes love-title-arrive {
  from { opacity: 0; transform: translate(-50%, -8px); }
  to { opacity: 1; transform: translate(-50%, 0); }
}

@keyframes love-word-arrive {
  from { opacity: 0; transform: translateY(12px) scale(.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes love-next-arrive {
  from { opacity: 0; transform: translateX(10px); }
  to { opacity: 1; transform: translateX(0); }
}



@keyframes stone-glow {
  from { transform: scale(.97); }
  to { transform: scale(1.04); }
}

@keyframes rock-arrive {
  from { opacity: 0; transform: translateY(18px) scale(.92); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes letters-arrive {
  from { opacity: 0; transform: translate(-50%, -42%) scale(.7); }
  to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
}

@keyframes answer-card-arrive {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes shake {
  25% { transform: translateX(-3px); }
  75% { transform: translateX(3px); }
}

@keyframes clue-twinkle {
  from { transform: rotate(-8deg) scale(.94); opacity: .7; }
  to { transform: rotate(8deg) scale(1.08); opacity: 1; }
}

@keyframes title-flash {
  from {
    opacity: .86;
    text-shadow:
      0 3px 0 #d6971c,
      0 8px 22px rgb(0 0 0 / 48%),
      0 0 24px rgb(255 222 58 / 36%);
  }
  to {
    opacity: 1;
    text-shadow:
      0 3px 0 #d6971c,
      0 8px 22px rgb(0 0 0 / 48%),
      0 0 54px rgb(255 222 58 / 78%);
  }
}

@keyframes scene-arrive {
  from { transform: scale(1.035); }
  to { transform: scale(1); }
}

@media (max-width: 760px) {
  .landing-art {
    background-position: 52% center;
  }

  .finale-level {
    padding-right: 14px;
    padding-left: 14px;
  }

  .memory-stage {
    height: min(58svh, 490px);
    min-height: 390px;
  }

  .memory-photo {
    width: min(66vw, 270px);
    height: min(48svh, 410px);
    min-height: 320px;
  }

  .meadow-header {
    width: calc(100% - 36px);
    height: 64px;
  }

  .meadow-instruction {
    top: 78px;
    border-radius: 15px;
  }

  .landing-content {
    padding-top: 36px;
    padding-bottom: 55px;
  }

  .landing-eyebrow {
    font-size: 10px;
    letter-spacing: 2px;
  }

  .site-header {
    width: calc(100% - 36px);
    height: 64px;
  }

  .page-shell {
    width: min(560px, calc(100% - 32px));
  }

  .intro {
    padding-top: 36px;
    padding-bottom: 24px;
  }

  .game-card {
    grid-template-columns: 1fr;
  }

  .riddle-panel {
    min-height: 342px;
    border-right: 0;
    border-bottom: 1px solid #e7e5d9;
  }

  .puzzle-panel {
    padding: 25px 25px 22px;
  }

  .puzzle-board {
    max-height: none;
  }

  .game-wallet {
    margin-left: auto;
  }
}

@media (max-width: 420px) {
  .landing-art {
    background-position: 54% center;
  }

  .finale-level {
    padding: 34px 10px 24px;
  }

  .finale-poem {
    padding: 20px 14px;
  }

  .memory-stage {
    height: min(58svh, 470px);
    min-height: 390px;
  }

  .memory-photo {
    width: min(68vw, 250px);
    height: min(48svh, 380px);
    min-height: 310px;
  }

  .landing-wallet {
    top: max(15px, env(safe-area-inset-top));
    right: max(14px, env(safe-area-inset-right));
    transform: scale(.9);
    transform-origin: top right;
  }

  .landing-title {
    margin-bottom: 29px;
    font-size: clamp(55px, 15vw, 72px);
  }

  .play-button {
    min-width: 162px;
    min-height: 58px;
  }

  .landing-subtitle {
    margin-top: 24px;
    font-size: 19px;
  }

  .site-header {
    width: calc(100% - 28px);
  }

  .meadow-header {
    width: calc(100% - 24px);
  }

  .meadow-header .brand {
    gap: 5px;
    font-size: 10px;
  }

  .meadow-header .chapter-label {
    font-size: 9px;
  }

  .meadow-header .game-wallet {
    gap: 4px;
    padding-right: 6px;
    font-size: 8px;
  }

  .meadow-header .game-wallet img {
    width: 21px;
    height: 21px;
  }

  .meadow-instruction {
    top: 76px;
    width: calc(100% - 28px);
    padding: 9px 12px;
    font-size: 11px;
    line-height: 1.4;
  }

  .meadow-rock {
    right: max(12px, env(safe-area-inset-right));
    bottom: max(18px, env(safe-area-inset-bottom));
    width: clamp(145px, 43vw, 205px);
  }

  .meadow-answer-card {
    padding: 72px 8px 64px;
  }

  .meadow-scroll {
    width: calc(100vw - 18px);
  }

  .meadow-scroll-copy {
    top: 19%;
    right: 18%;
    bottom: 18%;
    left: 18%;
  }

  .meadow-scroll-copy h1 {
    margin-bottom: 5px;
    font-size: clamp(13px, 4vw, 17px);
  }

  .meadow-letter-clue {
    margin-bottom: 5px;
    font-size: clamp(11px, 3.2vw, 14px);
  }

  .meadow-answer-form label {
    margin-bottom: 3px;
    font-size: 10px;
  }

  .meadow-answer-controls input,
  .meadow-answer-controls button {
    min-height: 34px;
    font-size: 13px;
  }

  .meadow-answer-controls button {
    padding-right: 10px;
    padding-left: 10px;
  }

  .meadow-message {
    min-height: 14px;
    margin-top: 3px;
    font-size: 9px;
  }

  .brand {
    gap: 7px;
    font-size: 12px;
  }

  .chapter-label {
    font-size: 10px;
  }

  .game-wallet {
    gap: 5px;
    padding-right: 8px;
    font-size: 9px;
  }

  .game-wallet img {
    width: 24px;
    height: 24px;
  }

  .page-shell {
    width: calc(100% - 24px);
  }

  .music-toggle {
    right: max(12px, env(safe-area-inset-right));
    bottom: max(12px, env(safe-area-inset-bottom));
  }

  body.love-level-active .music-toggle {
    right: auto;
  }

  .riddle-panel,
  .puzzle-panel {
    padding-right: 20px;
    padding-left: 20px;
  }

  .panel-heading h2,
  .puzzle-heading h2 {
    font-size: 18px;
  }

  .piece-counter {
    padding: 5px 7px;
    font-size: 9px;
  }

  .answer-options {
    gap: 7px;
  }

  .answer-option {
    padding-right: 10px;
    padding-left: 10px;
    font-size: 10px;
  }

  .end-screen {
    padding: 12px 10px 24px;
  }

  .end-screen-header {
    gap: 8px;
  }

  .end-chapter {
    max-width: 50%;
    font-size: 10px;
    letter-spacing: .3px;
  }

  .end-wallet {
    min-height: 36px;
    gap: 5px;
    padding-right: 8px;
    font-size: 9px;
  }

  .end-wallet img {
    width: 24px;
    height: 24px;
  }

  .end-content {
    min-height: calc(100svh - 80px);
  }

  .end-eyebrow {
    font-size: 10px;
    letter-spacing: 1.3px;
  }

  .scroll-stage {
    width: calc(100vw - 28px);
    max-width: 100%;
  }

  .scroll-copy {
    top: 19%;
    right: 19%;
    bottom: 18%;
    left: 19%;
  }

  .scroll-copy h1 {
    margin-bottom: 7px;
    font-size: clamp(13px, 4vw, 16px);
    line-height: 1.3;
  }

  .day-letter {
    font-size: clamp(12px, 3.8vw, 15px);
  }

  .end-prompt {
    max-width: 300px;
    margin: 0 0 12px;
    font-size: 11px;
    line-height: 1.5;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }

  .landing-title {
    animation: none;
  }

  .memory-photo {
    animation: none;
  }

}
